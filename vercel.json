{
  "framework": null,
  "outputDirectory": "web",
  "buildCommand": "",
  "installCommand": "npm install",
  "routes": [
    { "src": "^/$",                                       "dest": "/landing.html" },
    { "src": "^/briefings/?$",                            "dest": "/briefings/index.html" },
    { "src": "^/briefings/([0-9]{4}-[0-9]{2}-[0-9]{2})/(kospi|close|us)/?$", "dest": "/briefings/$1/$2/index.html" },
    { "src": "^/briefings/ko/([^/]+)/?$",                 "dest": "/briefings/$1/kospi/index.html" },
    { "src": "^/briefings/us/([^/]+)/?$",                 "dest": "/briefings/$1/us/index.html" },
    { "src": "^/briefings/ko-close/([^/]+)/?$",           "dest": "/briefings/$1/close/index.html" },
    { "src": "^/chips$",     "dest": "https://chipboard.vercel.app/chips" },
    { "src": "^/chips/(.*)", "dest": "https://chipboard.vercel.app/chips/$1" },
    { "handle": "filesystem" }
  ],
  "crons": [
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "10 0 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "30 0 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 1 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "30 1 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 2 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 3 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 4 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 5 * * 1-5" },
    { "path": "/api/trigger?type=kospi-news-live", "schedule": "0 6 * * 1-5" }
  ]
}
