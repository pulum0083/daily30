{
  "framework": null,
  "outputDirectory": "web",
  "buildCommand": "",
  "ignoreCommand": "git diff HEAD~1 --name-only | grep -qv '^web/data/kospi-news-live\\.json$'",
  "installCommand": "npm install",
  "routes": [
    { "src": "^/$",                                       "status": 301, "headers": { "Location": "/stocks/" } },
    { "src": "^/briefings/?$",                            "dest": "/briefings/2026-06-05/close/index.html" },
    { "src": "^/briefings/([0-9]{4}-[0-9]{2}-[0-9]{2})/(kospi|close|us)/?$", "dest": "/briefings/$1/$2/index.html" },
    { "src": "^/briefings/ko/([^/]+)/?$",                 "dest": "/briefings/$1/kospi/index.html" },
    { "src": "^/briefings/us/([^/]+)/?$",                 "dest": "/briefings/$1/us/index.html" },
    { "src": "^/briefings/ko-close/([^/]+)/?$",           "dest": "/briefings/$1/close/index.html" },
    { "src": "^/chips$",     "dest": "https://chipboard.vercel.app/chips" },
    { "src": "^/chips/(.*)", "dest": "https://chipboard.vercel.app/chips/$1" },
    { "handle": "filesystem" }
  ],
  "crons": []
}
